# HAM Spotter V1.13.9 — Universal configuration
# Fresh installations should use ./install.sh instead of editing this manually.
CALLSIGN=N0CALL
QTH_LOCATOR=JO00AA
HAMSPOTTER_LANGUAGE=en
HAMSPOTTER_PORT=8095
BANDS=6m,10m,12m,15m,17m,20m,40m,60m,80m,4m,2m,70cm,23cm
LOCAL_RX_RADIUS_KM=325
RETENTION_HOURS=24
ANALYSE_INTERVAL_SECONDS=30

# Dashboard
DASHBOARD_TIMEZONE=Europe/Berlin
DASHBOARD_DEFAULT_LAYER=hf
HF_LAYER_BANDS=6m,10m,12m,15m,17m,20m,40m,60m,80m
VHF_LAYER_BANDS=4m,2m,70cm,23cm
ACTIVITY_SAMPLE_SECONDS=60
ACTIVITY_RETENTION_DAYS=14
DASHBOARD_DECISION_CACHE_SECONDS=20
VHF_INTEL_CACHE_SECONDS=30
DASHBOARD_SECONDARY_CACHE_SECONDS=15

# PSK Reporter MQTT
PSKR_HOST=mqtt.pskreporter.info
PSKR_PORT=1884
PSKR_TLS=true

# Reverse Beacon Network
RBN_HOST=telnet.reversebeacon.net
RBN_CW_PORT=7000
RBN_FT8_PORT=7001
RBN_NODE_URL=https://www.reversebeacon.net/nodes/detail_json.php
RBN_NODE_REFRESH_MINUTES=60

# SSB / CW / DIGITAL
PRIMARY_PROP_MODE=ssb
DXCLUSTER_ENABLED=true
DXCLUSTER_HOST=dxspider.co.uk
DXCLUSTER_PORT=7300
# Installer sets this to CALLSIGN.
DXCLUSTER_LOGIN=N0CALL
DXCLUSTER_SILENCE_SECONDS=180
SSB_WINDOW_SECONDS=600

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS=false
TELEGRAM_COMMANDS=false
TELEGRAM_COOLDOWN_MINUTES=20

# Opening thresholds
WATCH_SCORE=40
OPEN_SCORE=65
STRONG_SCORE=85

# Minimum DX distances per band
MIN_DX_6M_KM=500
MIN_DX_10M_KM=800
MIN_DX_12M_KM=1000
MIN_DX_15M_KM=1200
MIN_DX_17M_KM=1500
MIN_DX_20M_KM=2500
MIN_DX_40M_KM=1800
MIN_DX_60M_KM=1200
MIN_DX_80M_KM=1200
MIN_DX_4M_KM=300
MIN_DX_2M_KM=200
MIN_DX_70CM_KM=150
MIN_DX_23CM_KM=100

# DXCC / prefix catalogues
ADIF_RESOURCE_URL=https://www.adif.org.uk/317/ADIF_317_resources_2026_03_22.zip
ADIF_REFRESH_HOURS=168
CTY_RESOURCE_URL=https://www.country-files.com/cty/cty.dat
CTY_REFRESH_HOURS=72

# Rare DX Intelligence
RARE_LOOKBACK_DAYS=90
RARE_LIVE_MINUTES=15
RARE_MIN_LEARNING_DAYS=7
RARE_MIN_STARS=2
RARE_LIVE_MIN_RX=1
RARE_WATCH_DXCC=

# Live DX Highlights
DX_LIVE_MINUTES=15
DX_LIVE_LIMIT=18
DX_LIVE_MIN_RX=1
DX_LIVE_MIN_SCORE=45

# Space weather / NOAA SWPC
SPACE_WEATHER_ENABLED=true
SPACE_WEATHER_REFRESH_SECONDS=300
